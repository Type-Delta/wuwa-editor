{
   "$schema": "./resources/patchSchema.json",
   "gameVersion": "2.1.0",
   "patchVersion": 3,
   "handlerVersion": 2,
   "configSrcMap": {
      "inputSettings": {
         "displayName": "Controls",
         "description": "Configure game Keybindings and Controller mappings (use 'combinedAction' to map combined inputs to a control setting)",
         "path": "./Wuthering Waves Game/Client/Saved/Config/WindowsNoEditor/Input.ini",
         "type": "plainText",
         "dataType": "KBTupleMap",
         "manifest": {
            "filter": "$type:AxisMappings"
         }
      },
      "userSettings": {
         "displayName": "Graphics",
         "description": "Configure game graphics",
         "path": "./Wuthering Waves Game/Client/Saved/Config/WindowsNoEditor/GameUserSettings.ini",
         "type": "plainText",
         "dataType": "ini"
      },
      "advanceSettings": {
         "displayName": "Advance Settings",
         "description": "Configure advance graphics and other game settings",
         "path": "./Wuthering Waves Game/Client/Saved/LocalStorage/LocalStorage.db",
         "type": "sqlite",
         "dataType": "literal",
         "manifest": {
            "acceptedGroups": [],
            "filter": "$sql:value not like '[%' and value not like '{%'",
            "readMapper": "$func:value = value === '\"___0B___\"'? false : (value === '\"___1B___\"'? true : value);if(['NvidiaSuperSamplingEnable','NvidiaReflex','MetalFxEnable','FsrEnable','XessEnable'].includes(key)) value = !!parseInt(value, 10);",
            "writeMapper": "$func:if(['NvidiaSuperSamplingEnable','NvidiaReflex','MetalFxEnable','FsrEnable','XessEnable'].includes(key)) value = value? 1 : 0;value = value === false? '\"___0B___\"' : (value === true? '\"___1B___\"' : value);",
            "literalTypeParsing": true,
            "selectedTable": "LocalStorage"
         }
      },
      "combinedAction": {
         "displayName": "Combined Input Actions",
         "description": "setting that defines combined Input action (key press, controller stick movement) into one binding them map them to 'inputSettings' key\nfor example, controller LB and controller X is mapped to '幻象2' (Echo Skill), by pressing said buttons at the same time, the game will register it as '幻象2' (Echo Skill)",
         "path": "./Wuthering Waves Game/Client/Saved/LocalStorage/LocalStorage.db",
         "type": "sqlite",
         "dataType": "JSON",
         "usedAsRaw": true,
         "disabled": true,
         "manifest": {
            "acceptedGroups": [
               "CombineAction"
            ],
            "selectedTable": "LocalStorage",
            "Reviver": "$func:if(value?.___MetaType___ == '___Map___') return new Map(value.Content)",
            "Replacer": "$func:if(value instanceof Map) return {___MetaType___: '___Map___', Content: Array.from(value.entries())};"
         }
      },
      "engineSettings": {
         "displayName": "Engine Settings",
         "description": "Configure game engine settings",
         "path": "./Wuthering Waves Game/Client/Saved/Config/WindowsNoEditor/Engine.ini",
         "type": "plainText",
         "dataType": "ini",
         "usedAsRaw": true
      }
   },
   "options": {
      "graphics": {
         "VSync": {
            "description": "Enable/Disable VSync",
            "key": "bUseVSync",
            "src": "userSettings",
            "type": "bool",
            "default": false
         },
         "Display Mode": {
            "description": "Set display mode\ncurrently, only 'Borderless Fullscreen' and 'Windowed' mode can be changed via in-game settings.\nThe game actually called 'Borderless Fullscreen' as 'Fullscreen' which can cause confusion.",
            "key": "FullscreenMode",
            "src": "userSettings",
            "type": "enum",
            "values": [
               "Fullscreen",
               "Borderless Fullscreen",
               "Windowed"
            ],
            "valueDesc": {
               "Fullscreen": "real Fullscreen mode (the game is always on top)",
               "Borderless Fullscreen": "Borderless window that covers the entire screen (allows other windows to shown on top of the game)",
               "Windowed": "Window with specific resolution"
            },
            "default": 1
         },
         "Brightness": {
            "description": "Set brightness level. however, it works more like a gamma correction.",
            "key": "Brightness",
            "src": "advanceSettings",
            "type": "number",
            "range": [-1, 1],
            "default": 0
         },
         "FPS Limit": {
            "description": "Set maximum frame rate\nSome ppl said that someone got baned from setting this value to 120, so do it with YOUR OWN RISK.\nPS: value higher than 60 will be shown in the game as 30)",
            "key": "CustomFrameRate",
            "src": "advanceSettings",
            "type": "enum",
            "values": [
               [1, "30"],
               [2, "60"],
               [3, "120"]
            ]
         },
         "HDR": {
            "description": "Enable/Disable HDR. for HDR supported monitors.",
            "key": "bUseHDRDisplayOutput",
            "src": "userSettings",
            "type": "bool",
            "default": false
         },
         "HDR Display Nits": {
            "description": "Set the HDR display nits",
            "key": "HDRDisplayOutputNits",
            "src": "userSettings",
            "type": "number"
         },
         "FrameRateLimit": {
            "description": "this setting shouldn't be edited by the user as the game would automatically overwrite it, FPS limit setting that the game will use is 'FPS Limit'",
            "key": "FrameRateLimit",
            "src": "userSettings",
            "type": "number",
            "editable": false
         },
         "Window Position X": {
            "description": "Set window position X (when display mode is Windowed)",
            "key": "WindowPosX",
            "src": "userSettings",
            "type": "number",
            "default": -1
         },
         "Window Position Y": {
            "description": "Set window position Y (when display mode is Windowed)",
            "key": "WindowPosY",
            "src": "userSettings",
            "type": "number",
            "default": -1
         },
         "Quality Setting Level": {
            "description": "Set game quality level? (may be a Duplicate of 'Quality Level' setting)",
            "editNote": "Changing this value may reset other settings to default as this may be a Duplicate of 'Quality Level' setting",
            "key": "GameQualitySettingLevel",
            "src": "userSettings",
            "type": "enum",
            "values": [
               "Low",
               "Medium",
               "High",
               "Custom"
            ]
         },
         "Last Fullscreen Mode": {
            "description": "if you wish to change the the Fullscreen mode, please use 'Display Mode' setting, is likely that the game would overwrite this setting",
            "key": "LastConfirmedFullscreenMode",
            "src": "userSettings",
            "type": "enum",
            "values": [
               "Fullscreen",
               "Borderless Fullscreen",
               "Windowed"
            ]
         },
         "Preferred Fullscreen Mode": {
            "description": "if you wish to change the the Fullscreen mode, please use 'Display Mode' setting, is likely that the game would overwrite this setting",
            "key": "PreferredFullscreenMode",
            "src": "userSettings",
            "type": "enum",
            "values": [
               "Fullscreen",
               "Borderless Fullscreen",
               "Windowed"
            ]
         },
         "Shadow Quality": {
            "description": "Set shadow quality",
            "key": "sg.ShadowQuality",
            "src": "userSettings",
            "type": "enum",
            "values": [
               "Low",
               "Medium",
               "High",
               "Ultra"
            ]
         },
         "Shadow Quality (2)": {
            "description": "may be a duplicate of 'Shadow Quality' setting",
            "key": "ShadowQuality",
            "src": "advanceSettings",
            "type": "enum",
            "values": [
               "Low",
               "Medium",
               "High",
               "Ultra"
            ]
         },
         "Image Quality": {
            "description": "Set image quality (may be a Duplicate of 'Quality Level' setting)",
            "key": "ImageQuality",
            "src": "advanceSettings",
            "type": "number",
            "range": [0]
         },
         "Image Details": {
            "description": "Set image details",
            "key": "ImageDetail",
            "src": "advanceSettings",
            "type": "number",
            "range": [0]
         },
         "Ray Tracing": {
            "description": "Enable/Disable Ray Tracing",
            "key": "RayTracing",
            "src": "advanceSettings",
            "type": "number"
         },
         "Ray Tracing GI": {
            "description": "Ray Tracing Global Illumination",
            "key": "RayTracedGI",
            "src": "advanceSettings",
            "type": "number",
            "default": 0
         },
         "Ray Tracing Reflections": {
            "description": "Ray Tracing Reflections",
            "key": "RayTracedReflection",
            "src": "advanceSettings",
            "type": "number",
            "default": 0
         },
         "Ray Tracing Shadow Quality": {
            "description": "Set Ray Tracing Shadow Quality",
            "key": "RayTracedShadow",
            "src": "advanceSettings",
            "type": "number",
            "default": 0
         },
         "Crowd Density": {
            "description": "Set Crowd Density",
            "key": "NpcDensity",
            "src": "advanceSettings",
            "type": "enum",
            "values": [
               "Low",
               "Medium",
               "High"
            ]
         },
         "Nvidia DLSS": {
            "description": "Enable/Disable Nvidia DLSS",
            "key": "NvidiaSuperSamplingEnable",
            "src": "advanceSettings",
            "type": "bool"
         },
         "Nvidia DLSS Mode": {
            "description": "Set Nvidia DLSS Mode\n3: Quality",
            "key": "NvidiaSuperSamplingMode",
            "src": "advanceSettings",
            "type": "number",
            "range": [0]
         },
         "Nvidia DLSS Frame Generate": {
            "description": "Nvidia DLSS Frame Generate?",
            "key": "NvidiaSuperSamplingFrameGenerate",
            "src": "advanceSettings",
            "type": "number",
            "range": [0]
         },
         "Nvidia DLSS Sharpness": {
            "description": "Set Nvidia DLSS Sharpness",
            "key": "NvidiaSuperSamplingSharpness",
            "src": "advanceSettings",
            "type": "number",
            "range": [0]
         },
         "Nvidia Reflex": {
            "description": "Enable/Disable Nvidia Reflex",
            "key": "NvidiaReflex",
            "src": "advanceSettings",
            "type": "bool"
         },
         "FSR": {
            "description": "Enable/Disable FidelityFX Super Resolution",
            "key": "FsrEnable",
            "src": "advanceSettings",
            "type": "bool"
         },
         "XeSS": {
            "description": "Enable/Disable XeSS",
            "key": "XessEnable",
            "src": "advanceSettings",
            "type": "bool"
         },
         "XeSS Quality": {
            "description": "Set XeSS Quality",
            "key": "XessQuality",
            "src": "advanceSettings",
            "type": "number",
            "range": [0]
         },
         "Ambient Occlusion": {
            "description": "Set Ambient Occlusion\n0: Disable\n1: Enable",
            "key": "SceneAo",
            "src": "advanceSettings",
            "type": "number"
         },
         "Metallic Fx": {
            "description": "Enable/Disable Metallic Fx",
            "key": "MetalFxEnable",
            "src": "advanceSettings",
            "type": "bool"
         }
      },
      "control axis": {
         "Look - Vertical": {
            "description": "Look Up/Down",
            "key": "LookUp",
            "src": "inputSettings",
            "allowMultiple": true,
            "type": "axis"
         },
         "Move - Vertical": {
            "description": "Move Forward/Backward\n(device positive value for forward, negative for backward)",
            "key": "MoveForward",
            "src": "inputSettings",
            "allowMultiple": true,
            "type": "axis"
         },
         "Look - Horizontal": {
            "description": "Look Left/Right",
            "key": "Turn",
            "src": "inputSettings",
            "allowMultiple": true,
            "type": "axis"
         },
         "Zoom": {
            "description": "Zoom In/Out",
            "key": "Zoom",
            "src": "inputSettings",
            "allowMultiple": true,
            "type": "axis"
         },
         "Move - Horizontal": {
            "description": "Move Left/Right\n(device positive value for right, negative for left)",
            "key": "MoveRight",
            "src": "inputSettings",
            "allowMultiple": true,
            "type": "axis"
         }
      },
      "Others": {
         "UserSettings.Version": {
            "description": "may be a version for 'GameUserSettings.ini' file",
            "key": "Version",
            "src": "userSettings",
            "type": "number",
            "default": 5
         },
         "Culture": {
            "description": "may be a Game language or Localization setting",
            "key": "Culture",
            "src": "userSettings",
            "type": "string",
            "default": "en"
         }
      }
   },
   "postprocessor": {
      "onChanged": {
         "Ray Tracing": "$func:if(newValue != 0){let e = settings.allRawSettings.get('engineSettings');e.value['/Script/Engine.RendererRTXSettings'] = {'r.RayTracing':newValue,'r.RayTracing.LimitDevice':0,'r.RayTracing.EnableInGame':1,'r.RayTracing.EnableOnDemand':1,'r.RayTracing.EnableInEditor':1};settings.allRawSettings.set('engineSettings', e);} else {let e = settings.allRawSettings.get('engineSettings');delete e.value['/Script/Engine.RendererRTXSettings'];settings.allRawSettings.set('engineSettings', e);};srcWithChanges.add('engineSettings');"
      }
   },
